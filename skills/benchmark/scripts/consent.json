{
  "_comment": "Consent-banner handlers, ordered by market share. Data, not code: add a handler after a mission where a banner survived, no script change needed. Handlers are tried in order; the first that clicks and makes the overlay disappear wins.",
  "handlers": [
    {
      "name": "didomi",
      "selectors": [
        "#didomi-notice-agree-button",
        "button#didomi-notice-agree-button",
        ".didomi-continue-without-agreeing"
      ],
      "search_frames": false
    },
    {
      "name": "onetrust",
      "selectors": [
        "#onetrust-accept-btn-handler",
        "#accept-recommended-btn-handler",
        ".ot-pc-refuse-all-handler"
      ],
      "search_frames": true
    },
    {
      "name": "axeptio",
      "selectors": [
        "#axeptio_btn_acceptAll",
        "button[data-testid='axeptio-accept-all']",
        ".axeptio_btn_acceptAll"
      ],
      "search_frames": true
    },
    {
      "name": "sirdata",
      "selectors": [
        "button.sd-cmp-JgqUW",
        ".sd-cmp-accept-all",
        "#sd-cmp button[title*='Accepter']"
      ],
      "search_frames": true
    },
    {
      "name": "cookiebot",
      "selectors": [
        "#CybotCookiebotDialogBodyLevelButtonLevelOptinAllowAll",
        "#CybotCookiebotDialogBodyButtonAccept"
      ],
      "search_frames": true
    },
    {
      "name": "tarteaucitron",
      "selectors": [
        "#tarteaucitronPersonalize",
        "#tarteaucitronAllAllowed",
        "button#tarteaucitronPersonalize2"
      ],
      "search_frames": false
    },
    {
      "name": "quantcast",
      "selectors": [
        "button[mode='primary'][class*='qc-cmp']",
        ".qc-cmp2-summary-buttons button:last-child"
      ],
      "search_frames": true
    },
    {
      "name": "usercentrics",
      "selectors": [
        "[data-testid='uc-accept-all-button']",
        "#uc-btn-accept-banner"
      ],
      "search_frames": true
    },
    {
      "name": "cookieyes",
      "selectors": [
        ".cky-btn-accept",
        "button[data-cky-tag='accept-button']"
      ],
      "search_frames": false
    },
    {
      "name": "generic-id",
      "selectors": [
        "[id*='cookie'] button[id*='accept']",
        "[class*='cookie'] button[class*='accept']",
        "[id*='consent'] button[id*='accept']"
      ],
      "search_frames": true
    }
  ],
