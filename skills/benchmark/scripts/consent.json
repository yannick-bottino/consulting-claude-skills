  "_kill_comment": "Overlays removed from the DOM when no button worked. Last resort: the page content matters more than a pixel-perfect banner dismissal.",
  "kill_selectors": [
    "#didomi-host",
    "#onetrust-consent-sdk",
    "#axeptio_overlay",
    "#sd-cmp",
    "#CybotCookiebotDialog",
    "#tarteaucitronRoot",
    ".qc-cmp2-container",
    "#usercentrics-root",
    ".cky-consent-container",
    "[class*='cookie-banner']",
    "[class*='cookie-consent']",
    "[id*='cookie-banner']"
  ],
